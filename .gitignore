# API keys and local environment configuration
.env
.env.*
!.env.example

# Keep the public grading key; never upload private grading keys.
agent_pipeline/keys/*
!agent_pipeline/keys/grading_public_key.pem

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter and editor state
.ipynb_checkpoints/
.vscode/
.idea/

# macOS and temporary Word files
.DS_Store
._*
~$*

# Local generated caches and maintenance files
output_files/processed_dataframes/
anaconda_projects/
temp_scripts/

# Raw logs and submission archives (encrypted logs remain included)
session_logs/*.jsonl
*.zip

# Generated Master intermediate CSV files
output_files/**/*.csv

# Required submission files are deliberately NOT ignored:
# agent_dev_workspace/  (tools and tests)
# session_logs/*.jsonl.enc
# reports/*.md
# plots/*.png
# Notebooks, Master answers, course data, and requirements.txt
